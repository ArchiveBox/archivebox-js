{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArchiveBox browser capture index record v2",
  "description": "ArchiveBox Snapshot and ArchiveResult records with browser execution metadata. The interchange version is in datapackage.archivebox, separate from ArchiveBox application versions.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type",
        "id",
        "url",
        "title",
        "depth",
        "created_at",
        "status",
        "config",
        "plugins",
        "capture_state"
      ],
      "properties": {
        "type": {
          "const": "Snapshot"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "const": "sealed"
        },
        "config": {
          "type": "object"
        },
        "plugin_config": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "plugins": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "capture_state": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "final_url": {
          "type": "string",
          "format": "uri"
        },
        "error": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "id",
        "snapshot_id",
        "plugin",
        "hook_name",
        "status",
        "output_str",
        "start_ts",
        "end_ts",
        "output_files",
        "output_json"
      ],
      "properties": {
        "type": {
          "const": "ArchiveResult"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "snapshot_id": {
          "type": "string",
          "format": "uuid"
        },
        "plugin": {
          "type": "string"
        },
        "hook_name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "skipped",
            "noresults"
          ]
        },
        "output_str": {
          "type": "string"
        },
        "start_ts": {
          "type": "string",
          "format": "date-time"
        },
        "end_ts": {
          "type": "string",
          "format": "date-time"
        },
        "output_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "extension",
              "mimetype",
              "size"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "extension": {
                "type": "string"
              },
              "mimetype": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "output_json": {
          "type": "object",
          "required": [
            "runtime",
            "hook_filename",
            "logs",
            "records"
          ],
          "properties": {
            "runtime": {
              "const": "browser"
            },
            "hook_filename": {
              "type": "string"
            },
            "ready_ts": {
              "type": "string",
              "format": "date-time"
            },
            "termination": {
              "const": "killed"
            },
            "logs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "url",
                  "ts",
                  "captureId"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^(https?://|urn:)"
                  },
                  "ts": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "captureId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "member": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "data": {}
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
