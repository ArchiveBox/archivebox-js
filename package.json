{
  "name": "archivebox-js",
  "description": "Browser-based web archiving with plugin hooks, portable WACZ captures, and offline replay",
  "repository": {"type":"git","url":"https://github.com/ArchiveBox/archivebox-js.git"},
  "homepage": "https://github.com/ArchiveBox/archivebox-js#readme",
  "packageManager": "pnpm@10.33.2",
  "engines": {"node": ">=22.12.0"},
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "compile": "tsc --noEmit",
    "test": "pnpm test:live",
    "test:live": "pnpm build && pnpm build:player && node tests/run-live.mjs",
    "test:replay": "playwright test tests/replaywebpage-live.test.ts tests/derivations-live.test.ts",
    "postinstall": "wxt prepare",
    "zip": "wxt zip",
    "build:player": "vite build --config vite.player.config.ts"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@llamaindex/liteparse-wasm": "2.15.1",
    "@mozilla/readability": "^0.6.0",
    "@paddleocr/paddleocr-js": "0.4.2",
    "@peculiar/x509": "1.14.3",
    "@postlight/parser": "2.2.3",
    "@webrecorder/wabac": "2.27.3",
    "@zip.js/zip.js": "2.23.0",
    "browsertrix-behaviors": "0.15.0",
    "buffer": "^6.0.3",
    "client-zip": "^2.5.1",
    "dashjs": "^5.2.1",
    "defuddle": "^0.19.4",
    "dompurify": "^3.4.16",
    "events": "^3.3.0",
    "fflate": "^0.8.2",
    "hash-wasm": "^4.12.0",
    "hls.js": "^1.7.3",
    "image-size": "2.0.2",
    "isomorphic-git": "^1.43.0",
    "jsonc-parser": "3.3.1",
    "linkedom": "^0.18.13",
    "lit": "3.1.1",
    "lucide-react": "^1.14.0",
    "m3u8-parser": "^7.2.0",
    "memfs": "^4.80.0",
    "minisearch": "7.2.0",
    "mpd-parser": "^1.4.0",
    "mupdf": "1.28.1",
    "officeparser": "8.1.0",
    "pako": "^3.0.2",
    "parse5": "^8.0.1",
    "path-browserify": "^1.0.1",
    "pyodide": "0.29.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "readable-stream": "^4.7.0",
    "single-file-core": "1.6.24",
    "url": "^0.11.4",
    "uuid": "^14.0.2",
    "warcio": "2.4.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "replaywebpage": "2.5.3",
    "typescript": "^5.9.3",
    "vite": "8.0.12",
    "wxt": "^0.20.26"
  },
  "license": "AGPL-3.0-or-later"
}
